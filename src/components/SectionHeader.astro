---
interface Props {
  kicker: string; // short label, e.g. "Experience"
  title: string;
  desc: string; // plain-language explanation of the section
}
const { kicker, title, desc } = Astro.props;
---

<div class="reveal max-w-2xl">
  <span class="kicker">{kicker}</span>

  <h2 class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">
    {title}
  </h2>

  <!-- Plain-language explanation of what this section is -->
  <p class="mt-4 text-[color:var(--color-fg-muted)] text-base sm:text-lg leading-relaxed">
    {desc}
  </p>
</div>
