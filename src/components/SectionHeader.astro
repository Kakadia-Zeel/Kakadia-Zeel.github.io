---
interface Props {
  kicker: string;
  title: string;
  desc: string;
}
const { kicker, title, desc } = Astro.props;
---

<div class="reveal max-w-2xl">
  <span class="kicker">{kicker}</span>
  <h2 class="mt-4 text-[1.75rem] sm:text-4xl font-semibold gradient-text">{title}</h2>
  <p class="mt-3 muted text-base sm:text-lg">{desc}</p>
</div>
