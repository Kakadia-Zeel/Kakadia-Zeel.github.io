---
import { site, sections } from '../data/site';
import Icon from './Icon.astro';
const s = sections.contact;
---

<section id="contact" class="py-24 sm:py-32 border-t" style="border-color:var(--border);">
  <div class="mx-auto max-w-5xl px-5 sm:px-6 text-center">
    <div class="reveal max-w-2xl mx-auto">
      <span class="kicker">{s.kicker}</span>
      <h2 class="mt-4 text-3xl sm:text-5xl font-semibold">{s.title}</h2>
      <p class="mt-4 muted text-lg leading-relaxed">{s.desc}</p>

      <a href={`mailto:${site.email}`} class="btn btn-primary mt-8">
        <Icon name="mail" class="w-4 h-4" /> Email me
      </a>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 text-sm">
        <a href={`mailto:${site.email}`} class="ulink">{site.email}</a>
        <a href={site.links.github} target="_blank" rel="noopener" class="ulink">GitHub</a>
        <a href={site.links.linkedin} target="_blank" rel="noopener" class="ulink">LinkedIn</a>
        <a href={site.links.leetcode} target="_blank" rel="noopener" class="ulink">LeetCode</a>
        <a href={site.links.resume} target="_blank" rel="noopener" class="ulink">Résumé</a>
      </div>
    </div>
  </div>
</section>
