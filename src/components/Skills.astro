---
import { skillGroups, sections } from '../data/site';
import SectionHeader from './SectionHeader.astro';
const s = sections.skills;
---

<section id="skills" class="py-20 sm:py-28 border-t" style="border-color:var(--border);">
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <SectionHeader kicker={s.kicker} title={s.title} desc={s.desc} />

    <div class="mt-10 grid sm:grid-cols-2 gap-x-12 gap-y-8">
      {
        skillGroups.map((group) => (
          <div class="reveal">
            <h3 class="text-sm font-medium dim uppercase tracking-wider">{group.title}</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="tag">{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
