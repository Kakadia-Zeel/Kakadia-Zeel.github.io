---
import { sideProjects, sections } from '../data/site';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
const s = sections.projects;
---

<section id="projects" class="py-20 sm:py-28 border-t" style="border-color:var(--border);">
  <div class="mx-auto max-w-5xl px-5 sm:px-6">
    <SectionHeader kicker={s.kicker} title={s.title} desc={s.desc} />

    <div class="mt-10 grid sm:grid-cols-2 gap-5">
      {
        sideProjects.map((p) => (
          <article class="card card-hover p-6 flex flex-col group">
            <div class="flex items-start justify-between">
              <h3 class="text-lg font-semibold font-display group-hover:accent transition-colors">{p.title}</h3>
              {p.link && (
                <a href={p.link} target="_blank" rel="noopener" aria-label="Open project" class="dim hover:accent transition-colors">
                  <Icon name="arrow" class="w-5 h-5" />
                </a>
              )}
            </div>
            <p class="mt-2 muted text-sm leading-relaxed flex-1">{p.blurb}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {p.tags.map((t) => (
                <span class="tag !text-xs !py-1 !px-2.5">{t}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
