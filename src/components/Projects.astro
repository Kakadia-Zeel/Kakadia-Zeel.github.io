---
import { sideProjects, sections } from '../data/site';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
const s = sections.projects;
---

<section id="projects" class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader kicker={s.kicker} title={s.title} desc={s.desc} />

    <div class="mt-10 grid sm:grid-cols-2 gap-4 sm:gap-5">
      {
        sideProjects.map((p) => (
          <article class="glass glass-hover spotlight rounded-2xl p-6 flex flex-col group">
            <div class="flex items-start justify-between gap-4">
              <span
                class="w-12 h-12 rounded-xl grid place-items-center text-[color:var(--color-accent-cyan)] shrink-0"
                style="background:rgba(34,211,238,.08);border:1px solid rgba(34,211,238,.2);"
              >
                <Icon name={p.icon} class="w-6 h-6" />
              </span>
              {p.link && (
                <a href={p.link} target="_blank" rel="noopener" aria-label="Open project"
                  class="text-[color:var(--color-fg-dim)] hover:text-[color:var(--color-accent-cyan)] transition-colors">
                  <Icon name="arrow" class="w-5 h-5" />
                </a>
              )}
            </div>

            <h3 class="mt-5 text-lg font-semibold text-fg group-hover:text-[color:var(--color-accent-cyan)] transition-colors">
              {p.title}
            </h3>
            <p class="mt-2 text-sm text-[color:var(--color-fg-muted)] leading-relaxed flex-1">{p.blurb}</p>

            <div class="mt-4 flex flex-wrap gap-1.5">
              {p.tags.map((t) => (
                <span class="font-mono text-[0.7rem] px-2 py-1 rounded-md bg-white/5 border border-white/8 text-[color:var(--color-fg-dim)]">
                  {t}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
