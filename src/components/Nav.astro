---
import { site, nav } from '../data/site';
---

<header class="fixed top-0 inset-x-0 z-50">
  <nav class="mx-auto max-w-6xl px-4 sm:px-6 mt-3">
    <div class="glass glass-blur rounded-2xl px-4 sm:px-5 py-3 flex items-center justify-between">
      <a href="#top" class="font-mono font-bold tracking-tight text-fg flex items-center gap-2">
        <span class="inline-grid place-items-center w-8 h-8 rounded-lg text-[#05060a]"
          style="background:linear-gradient(120deg,var(--color-accent-cyan),var(--color-accent-violet));">ZK</span>
        <span class="hidden sm:inline">zeelkakadia<span class="accent-text">.dev</span></span>
      </a>

      <ul class="hidden md:flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="px-3 py-2 rounded-lg text-sm text-[color:var(--color-fg-muted)] hover:text-fg hover:bg-white/5 transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <a href={site.links.resume} target="_blank" rel="noopener" class="hidden sm:inline-flex btn btn-ghost !py-2 !px-3.5 text-sm">
          Résumé
        </a>
        <a href="#contact" class="btn btn-primary !py-2 !px-4 text-sm">Get in touch</a>
      </div>
    </div>
  </nav>
</header>
