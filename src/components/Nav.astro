---
import { site, nav } from '../data/site';
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
---

<header class="fixed top-0 inset-x-0 z-50">
  <nav class="mx-auto max-w-6xl px-4 sm:px-6 mt-3">
    <div class="glass glass-blur rounded-2xl px-3 sm:px-5 py-2.5 flex items-center justify-between">
      <a href="#top" class="font-mono font-bold tracking-tight text-fg flex items-center gap-2.5">
        <Avatar id="logo" class="w-9 h-9 shrink-0" />
        <span class="text-sm sm:text-base">zeelkakadia<span class="accent-text">.dev</span></span>
      </a>

      <!-- Desktop links -->
      <ul class="hidden md:flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="px-3 py-2 rounded-lg text-sm text-[color:var(--color-fg-muted)] hover:text-fg hover:bg-white/5 transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <a href={site.links.resume} target="_blank" rel="noopener" class="hidden sm:inline-flex btn btn-ghost !py-2 !px-3.5 text-sm">
          Résumé
        </a>
        <a href="#contact" class="hidden sm:inline-flex btn btn-primary !py-2 !px-4 text-sm">Get in touch</a>

        <!-- Mobile hamburger -->
        <button
          id="menu-btn"
          class="md:hidden w-10 h-10 grid place-items-center rounded-lg text-fg hover:bg-white/5 transition-colors"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="menu" class="w-6 h-6" id="menu-icon" />
        </button>
      </div>
    </div>

    <!-- Mobile menu panel -->
    <div id="mobile-menu" class="md:hidden hidden mt-2 glass glass-blur rounded-2xl p-2">
      <ul class="flex flex-col">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="menu-link block px-4 py-3 rounded-xl text-[color:var(--color-fg-muted)] hover:text-fg hover:bg-white/5 transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="grid grid-cols-2 gap-2 mt-2 px-1 pb-1">
          <a href={site.links.resume} target="_blank" rel="noopener" class="menu-link btn btn-ghost !py-2.5 text-sm">Résumé</a>
          <a href="#contact" class="menu-link btn btn-primary !py-2.5 text-sm">Get in touch</a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('menu-icon');

  const setOpen = (open: boolean) => {
    if (!menu || !btn) return;
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    // swap hamburger <-> X
    if (icon) {
      icon.innerHTML = open
        ? '<path d="M6 6l12 12M18 6L6 18"/>'
        : '<path d="M4 7h16M4 12h16M4 17h16"/>';
    }
  };

  btn?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? true));

  // Close after tapping a link
  document.querySelectorAll('#mobile-menu .menu-link').forEach((a) =>
    a.addEventListener('click', () => setOpen(false))
  );

  // Close if resized up to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) setOpen(false);
  });
</script>
