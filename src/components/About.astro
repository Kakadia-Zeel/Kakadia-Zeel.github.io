---
import { education, sections } from '../data/site';
import SectionHeader from './SectionHeader.astro';
const s = sections.about;
---

<section id="about" class="py-20 sm:py-28 border-t" style="border-color:var(--border);">
  <div class="mx-auto max-w-5xl px-5 sm:px-6">
    <SectionHeader kicker={s.kicker} title={s.title} desc={s.desc} />

    <div class="mt-10 grid lg:grid-cols-[1.6fr_1fr] gap-10 lg:gap-16 items-start">
      <div class="reveal space-y-5 text-[color:var(--muted)] text-lg leading-relaxed">
        <p>
          I'm a software engineer with <span class="text-[color:var(--text)] font-medium">4+ years</span> building
          scalable REST APIs and data systems in <span class="text-[color:var(--text)] font-medium">Java &amp;
          Spring Boot</span> — backend work where correctness, performance and clean migrations matter.
        </p>
        <p>
          At <span class="text-[color:var(--text)] font-medium">Aera Technology</span> I automated multi-tenant
          migrations, built role-based graph services on Neo4j, and shipped a GenAI metadata pipeline — the bridge
          that pulled me toward AI/ML in earnest.
        </p>
        <p>
          I've since worked hands-on with <span class="text-[color:var(--text)] font-medium">Snorkel</span> and
          <span class="text-[color:var(--text)] font-medium">Abundant</span> on data labeling &amp; model
          evaluation. I'm now looking for <span class="text-[color:var(--text)] font-medium">remote roles and
          freelance clients</span> where solid engineering meets modern AI.
        </p>
      </div>

      <div class="reveal">
        <div class="card p-6">
          <span class="kicker">Education</span>
          <h3 class="mt-3 text-lg font-semibold font-display">{education.school}</h3>
          <p class="mt-1 muted">{education.degree}</p>
          <p class="mt-1 dim text-sm">{education.period}</p>
          <p class="mt-4 accent text-sm font-medium">{education.detail}</p>
        </div>
      </div>
    </div>
  </div>
</section>
