---
import { education, sections } from '../data/site';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
const s = sections.about;
---

<section id="about" class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader kicker={s.kicker} title={s.title} desc={s.desc} />

    <div class="mt-10 grid lg:grid-cols-[1.5fr_1fr] gap-8 lg:gap-12 items-start">
      <div class="reveal flex flex-col sm:flex-row gap-6">
        <!-- Avatar / photo placeholder -->
        <div class="shrink-0">
          <div class="glass rounded-2xl p-1.5 w-24 h-24">
            <!--
              TODO: drop your photo at /public/images/photo.jpg then replace the
              block below with:
              <img src="/images/photo.jpg" alt="Zeel Kakadia" class="w-full h-full object-cover rounded-xl" />
            -->
            <div class="w-full h-full rounded-xl grid place-items-center"
              style="background:radial-gradient(120% 120% at 20% 0%, rgba(79,140,255,.25), transparent 60%), var(--color-ink-850);">
              <span class="font-mono text-2xl font-bold accent-text">ZK</span>
            </div>
          </div>
        </div>

        <div class="space-y-4 text-[color:var(--color-fg-muted)] text-base sm:text-lg leading-relaxed">
          <p>
            I'm a software engineer with <span class="text-fg font-medium">4+ years</span> building scalable
            REST APIs and data systems in <span class="text-fg font-medium">Java &amp; Spring Boot</span> — the
            kind of backend work where correctness, performance and clean migrations actually matter.
          </p>
          <p>
            At <span class="text-fg font-medium">Aera Technology</span> I automated multi-tenant migrations,
            built role-based graph services on Neo4j, and shipped a GenAI metadata pipeline — the bridge that
            pulled me toward AI/ML in earnest.
          </p>
          <p>
            I've since worked hands-on with <span class="text-fg font-medium">Snorkel</span> and
            <span class="text-fg font-medium">Abundant</span> on data labeling &amp; model evaluation, and built
            a body of AI task/eval work. I'm now looking for
            <span class="text-fg font-medium">remote roles and freelance clients</span> where solid engineering
            meets modern AI.
          </p>
        </div>
      </div>

      <!-- Education card -->
      <div class="reveal">
        <div class="glass glass-hover spotlight rounded-2xl p-6">
          <div class="flex items-center gap-3 text-[color:var(--color-accent-cyan)]">
            <Icon name="cap" class="w-6 h-6" />
            <span class="section-label !text-[color:var(--color-fg-dim)]">Education</span>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-fg">{education.school}</h3>
          <p class="mt-1 text-[color:var(--color-fg-muted)]">{education.degree}</p>
          <p class="mt-1 text-sm text-[color:var(--color-fg-dim)] font-mono">{education.period}</p>
          <div class="mt-4 inline-flex chip">{education.detail}</div>
        </div>
      </div>
    </div>
  </div>
</section>
