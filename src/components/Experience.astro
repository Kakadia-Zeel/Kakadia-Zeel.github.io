---
import { experience, sections } from '../data/site';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
const s = sections.experience;
---

<section id="experience" class="py-20 sm:py-28 border-t" style="border-color:var(--border);">
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <SectionHeader kicker={s.kicker} title={s.title} desc={s.desc} />

    <!-- Timeline -->
    <div class="mt-14 relative">
      <span class="tl-rail absolute left-[7px] top-3 bottom-10 w-[2px] rounded-full" aria-hidden="true"></span>

      <div class="space-y-14">
        {
          experience.map((job) => (
            <div class="tl-entry relative pl-8 sm:pl-10 reveal">
              {/* node dot on the rail */}
              <span
                class:list={['tl-node absolute left-0 top-2 w-4 h-4 rounded-full', job.current && 'is-current']}
                aria-hidden="true"
              />

              {/* header */}
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1">
                <div>
                  <h3 class="text-xl sm:text-2xl font-semibold font-display flex items-center gap-x-3 gap-y-1 flex-wrap">
                    {job.url ? (
                      <a href={job.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:accent transition-colors">
                        {job.company}
                        <Icon name="arrow" class="w-4 h-4 dim" />
                      </a>
                    ) : (
                      job.company
                    )}
                    {job.via && <span class="text-sm font-sans font-normal dim">via {job.via}</span>}
                    {job.current && (
                      <span class="text-[0.68rem] font-sans font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full" style="color:var(--accent-ink); background:linear-gradient(100deg,var(--grad-1),var(--grad-2));">
                        Present
                      </span>
                    )}
                  </h3>
                  <p class="gradient-text font-semibold mt-1 inline-block">{job.role}</p>
                </div>
                <p class="dim text-sm shrink-0 sm:text-right sm:pt-1">{job.period} · {job.type}</p>
              </div>

              {job.highlight && (
                <p class="mt-3 text-sm muted flex items-center gap-1.5">
                  <Icon name="spark" class="w-4 h-4 accent" />
                  {job.highlight}
                </p>
              )}

              <p class="mt-4 muted leading-relaxed max-w-3xl">{job.summary}</p>

              {job.tags && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {job.tags.map((t) => (
                    <span class="tag !text-xs !py-1 !px-2.5">{t}</span>
                  ))}
                </div>
              )}

              {job.points && (
                <ul class="mt-5 space-y-2 max-w-3xl">
                  {job.points.map((p) => (
                    <li class="flex gap-3 muted leading-relaxed">
                      <span class="dim mt-0.5 select-none">—</span>
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              )}

              {job.areas && (
                <div class="mt-6 space-y-6 max-w-3xl">
                  {job.areas.map((area, i) => (
                    <div class="pt-6 border-t" style="border-color:var(--border);">
                      <div class="flex items-baseline gap-3">
                        <span class="gradient-text font-display font-semibold text-sm">{String(i + 1).padStart(2, '0')}</span>
                        <h4 class="text-lg font-semibold font-display">{area.title}</h4>
                      </div>
                      <p class="mt-2 muted leading-relaxed">{area.explain}</p>
                      <ul class="mt-3 space-y-2">
                        {area.points.map((point) => (
                          <li class="flex gap-3 muted leading-relaxed">
                            <span class="dim mt-0.5 select-none">—</span>
                            <span>{point}</span>
                          </li>
                        ))}
                      </ul>
                      {area.metrics.length > 0 && (
                        <div class="mt-4 flex flex-wrap gap-x-8 gap-y-3">
                          {area.metrics.map((m) => (
                            <div>
                              <span class="text-xl font-semibold font-display gradient-text inline-block">
                                {'num' in m ? `${m.num}${m.suffix}` : m.text}
                              </span>
                              <span class="dim text-sm ml-2">{m.label}</span>
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
