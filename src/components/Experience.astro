---
import { experience, sections } from '../data/site';
import SectionHeader from './SectionHeader.astro';
const s = sections.experience;
---

<section id="experience" class="py-20 sm:py-28 border-t" style="border-color:var(--border);">
  <div class="mx-auto max-w-5xl px-5 sm:px-6">
    <SectionHeader kicker={s.kicker} title={s.title} desc={s.desc} />

    {
      experience.map((job) => (
        <div class="mt-12">
          {/* Company header */}
          <div class="reveal flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
            <div>
              <h3 class="text-2xl font-semibold font-display">{job.company}</h3>
              <p class="accent font-medium mt-0.5">{job.role}</p>
            </div>
            <p class="dim text-sm">
              {job.period} · {job.type}
            </p>
          </div>
          <p class="reveal mt-4 muted leading-relaxed max-w-3xl">{job.summary}</p>

          {/* Work areas — point-wise with explanations */}
          <div class="mt-10 space-y-10">
            {job.areas.map((area, i) => (
              <div class="reveal grid sm:grid-cols-[auto_1fr] gap-x-6 gap-y-3 pt-8 border-t" style="border-color:var(--border);">
                <span class="hidden sm:block dim font-display text-sm pt-1">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h4 class="text-xl font-semibold font-display">{area.title}</h4>
                  <p class="mt-2 muted leading-relaxed">{area.explain}</p>

                  <ul class="mt-4 space-y-2">
                    {area.points.map((point) => (
                      <li class="flex gap-3 muted leading-relaxed">
                        <span class="accent mt-0.5 select-none">—</span>
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>

                  {area.metrics.length > 0 && (
                    <div class="mt-5 flex flex-wrap gap-x-10 gap-y-4">
                      {area.metrics.map((m) => (
                        <div>
                          <div class="text-2xl font-semibold font-display accent">
                            {'num' in m ? `${m.num}${m.suffix}` : m.text}
                          </div>
                          <div class="dim text-sm mt-0.5">{m.label}</div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
