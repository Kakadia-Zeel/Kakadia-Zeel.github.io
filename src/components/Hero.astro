---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<section id="top" class="min-h-[92vh] flex flex-col justify-center pt-28 pb-16">
  <div class="mx-auto max-w-5xl px-5 sm:px-6 w-full">
    <div class="reveal">
      {
        site.available && (
          <span class="inline-flex items-center gap-2 text-sm muted mb-8">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-60" style="background:var(--accent);" />
              <span class="relative inline-flex rounded-full h-2 w-2" style="background:var(--accent);" />
            </span>
            Available for opportunities
          </span>
        )
      }

      <h1 class="font-display font-semibold tracking-tight text-5xl sm:text-7xl lg:text-[5.5rem] leading-[1.02]">
        Zeel Kakadia
      </h1>

      <p class="mt-6 text-xl sm:text-2xl font-display text-[color:var(--text)]">
        Backend Engineer <span class="accent">→</span> AI / ML
      </p>

      <p class="mt-6 muted text-lg sm:text-xl max-w-2xl leading-relaxed">
        {site.tagline}
      </p>

      <p class="mt-6 dim text-sm flex items-center gap-2">
        <Icon name="location" class="w-4 h-4" />
        {site.location}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#contact" class="btn btn-primary">
          <Icon name="mail" class="w-4 h-4" /> Get in touch
        </a>
        <a href={site.links.resume} target="_blank" rel="noopener" class="btn btn-ghost">
          <Icon name="download" class="w-4 h-4" /> Résumé
        </a>
      </div>

      <div class="mt-10 flex items-center gap-6 text-sm">
        <a href={site.links.github} target="_blank" rel="noopener" class="ulink">GitHub</a>
        <a href={site.links.linkedin} target="_blank" rel="noopener" class="ulink">LinkedIn</a>
        <a href={site.links.leetcode} target="_blank" rel="noopener" class="ulink">LeetCode</a>
      </div>
    </div>
  </div>
</section>
