---
// A little "techie" robot avatar (inline SVG, Ember gradient, blinking eyes).
// Used as the site logo. id must be unique per instance for the gradient.
interface Props {
  class?: string;
  id?: string;
}
const { class: className = 'w-9 h-9', id = 'av' } = Astro.props;
---

<svg class={className} viewBox="0 0 40 40" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-g`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fbbf24" />
      <stop offset="0.5" stop-color="#fb923c" />
      <stop offset="1" stop-color="#fb7185" />
    </linearGradient>
  </defs>

  <!-- antenna -->
  <line x1="20" y1="3.5" x2="20" y2="9" stroke={`url(#${id}-g)`} stroke-width="2" stroke-linecap="round" />
  <circle cx="20" cy="3" r="2" fill={`url(#${id}-g)`} />

  <!-- headphone / ears -->
  <rect x="3.5" y="16" width="3.2" height="8" rx="1.6" fill={`url(#${id}-g)`} />
  <rect x="33.3" y="16" width="3.2" height="8" rx="1.6" fill={`url(#${id}-g)`} />

  <!-- head -->
  <rect x="7" y="9" width="26" height="22" rx="7" fill="#0e1018" stroke={`url(#${id}-g)`} stroke-width="2" />

  <!-- eyes (blink) -->
  <circle class="av-eye" cx="15" cy="19" r="2.6" fill={`url(#${id}-g)`} />
  <circle class="av-eye" cx="25" cy="19" r="2.6" fill={`url(#${id}-g)`} />

  <!-- mouth -->
  <rect x="14" y="25" width="12" height="2.2" rx="1.1" fill="#fb923c" opacity="0.75" />
</svg>
